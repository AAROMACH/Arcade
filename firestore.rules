rules_version = '2';
// Aaromach Arcade leaderboard.
// Anyone can read the scores. Nobody can write them from the browser: scores, names and runs
// are written only by the Cloud Functions in functions/ (which use admin access and check each
// score first). Everything else in the database is closed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{uid} {
      allow read: if true;
      allow write: if false;
    }
    // Game saves (Dispatch Board's company): only the player, and only once signed in with Google.
    // Not a score: the leaderboard still only takes what the Cloud Functions check.
    match /saves/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid && 'google.com' in request.auth.token.firebase.identities;
      allow create, update: if request.auth != null && request.auth.uid == uid && 'google.com' in request.auth.token.firebase.identities
        && request.resource.data.keys().hasOnly(['dispatch-board', 'updated']);
    }
    // runs/ and limits/ are server-only bookkeeping: no rule means no access.
  }
}
